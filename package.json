  "description": "",
  "type": "module",
  "scripts": {
    "start-2024-1": "node dist/2024-three-hop/1-customer-pay-decathlon/server.js",
    "start-2024-1:watch": "nodemon dist/2024-three-hop/1-customer-pay-decathlon/server.js",
    "start-2024-2": "node dist/2024-three-hop/2-transfer-payment-to-imin/transferPaymentToImin.js",
