    "start-2024-webhook:watch": "nodemon dist/2024-three-hop/webhook/webhook.js",
    "copy-public-dir": "mkdir -p dist/2024-three-hop/1-customer-pay-decathlon/public && cp src/2024-three-hop/1-customer-pay-decathlon/public/* dist/2024-three-hop/1-customer-pay-decathlon/public && mkdir -p dist/2025-on-behalf-of/1-customer-pay-decathlon/public && cp src/2025-on-behalf-of/1-customer-pay-decathlon/public/* dist/2025-on-behalf-of/1-customer-pay-decathlon/public",
    "build": "npm run clean && npm run copy-public-dir && tsc",
    "build:watch": "npm run clean && npm run copy-public-dir && tsc --watch",
    "ts-check": "tsc --noEmit",
    "test": "npm run lint && npm run prettier-format && npm run ts-check",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write"
